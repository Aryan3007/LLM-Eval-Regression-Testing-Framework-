# Root env for docker compose. Copy to .env. Never commit .env.
POSTGRES_USER=llmeval
POSTGRES_PASSWORD=change-me
# Host port for Postgres (5433 avoids clashing with a local Postgres on 5432)
POSTGRES_PORT=5433

# DocsBot model provider (any OpenAI-compatible API)
OPENAI_API_KEY=
# OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Any chat-completions model your provider offers, e.g. gpt-4.1-mini
CHAT_MODEL=
CHAT_TEMPERATURE=0

# Which ingested collection DocsBot answers from, and how many chunks it retrieves
DOCSBOT_COLLECTION=fastapi-0.115.0-c512-o64
DOCSBOT_TOP_K=5
