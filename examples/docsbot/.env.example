# Copy to .env for running DocsBot outside Docker. Never commit .env.
NODE_ENV=development
PORT=8001
LOG_LEVEL=info

# Postgres from the root docker-compose.yml (host port POSTGRES_PORT, default 5433)
DATABASE_URL=postgres://llmeval:change-me@localhost:5433/docsbot
DATABASE_URL_TEST=postgres://llmeval:change-me@localhost:5433/docsbot_test
DB_POOL_MAX=10

# Any OpenAI-compatible API. Set OPENAI_BASE_URL to use e.g. Groq for chat.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Any chat-completions model your provider offers, e.g. gpt-4.1-mini
CHAT_MODEL=
# Leave unset for models that don't accept a temperature
CHAT_TEMPERATURE=0

# Retrieval
COLLECTION=fastapi-0.115.0-c512-o64
TOP_K=5
PROMPT_PATH=prompts/answer.md
